    <ClInclude Include="src\core\match.hpp" />
    <ClInclude Include="src\core\ai.hpp" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="src\tests\main.cpp" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
